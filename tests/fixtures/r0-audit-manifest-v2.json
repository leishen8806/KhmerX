{
  "secret": "synthetic-audit-integrity-secret-0123456789",
  "scenarios": [
    {
      "name": "same-millisecond",
      "rows": [
        ["a-001", "reviewer-a", "kyc_material_read", "{\"slot\":\"idFront\"}", "2026-10-27T01:00:00.010Z"],
        ["a-002", "reviewer-a", "kyc_material_read", "{\"slot\":\"idBack\"}", "2026-10-27T01:00:00.010Z"]
      ],
      "expected": {"match": true, "tampered": false, "appendedRows": 0}
