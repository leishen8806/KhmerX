      "rows": [
        ["b-001", "reviewer-a", "kyc_material_read", "{\"slot\":\"idFront\"}", "2026-10-27T01:00:00.010Z"],
        ["b-002", "reviewer-a", "kyc_material_read", "{\"slot\":\"idBack\"}", "2026-10-27T01:00:00.011Z"],
        ["b-000", "reviewer-a", "kyc_material_read", "{\"slot\":\"selfie\"}", "2026-10-27T01:00:00.009Z"]
      ],
      "expected": {"match": false, "tampered": true, "appendedRows": 1}
    },
    {
      "name": "edit",
      "rows": [["c-001", "reviewer-a", "kyc_material_read", "{\"slot\":\"idFront\"}", "2026-10-27T01:00:00.010Z"]],
      "editedDetail": "{\"slot\":\"idBack\"}",
      "expected": {"match": false, "tampered": true, "appendedRows": 0}
    },
    {
      "name": "delete",
      "manifestCount": 2,
      "rows": [
        ["d-001", "reviewer-a", "kyc_material_read", "{\"slot\":\"idFront\"}", "2026-10-27T01:00:00.010Z"],
        ["d-002", "reviewer-a", "kyc_material_read", "{\"slot\":\"idBack\"}", "2026-10-27T01:00:00.011Z"]
      ],
      "deleteIndex": 1,
      "expected": {"match": false, "tampered": true, "appendedRows": -1}
    }
  ]
