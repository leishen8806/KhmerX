# Only test funds. Keep bot tokens server-side. Local preview uses Sites local identity.
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=

# H5 customer verification (server-only). Set a random secret of at least 32 characters.
# demo accepts only fictional +12025550100..+12025550199 and never contacts Telegram.
PAYEASE_AUTH_MODE=demo
PAYEASE_AUTH_SECRET=
PAYEASE_IDENTITY_PROOF_SECRET=
PAYEASE_IDENTITY_PROOF_REQUIRED=true
# Obtain from Telegram Gateway, NOT BotFather. Required only when mode=telegram.
TELEGRAM_GATEWAY_TOKEN=

# KYC reviewer allowlist: platform-authenticated emails, comma separated. Empty denies review.
KYC_REVIEWER_EMAILS=
# Separate AES-GCM key material (minimum 32 random characters). Back up securely.
KYC_DATA_SECRET=

# Authenticated daily post-loan job endpoint; random secret, minimum 32 characters.
POSTLOAN_JOB_SECRET=
