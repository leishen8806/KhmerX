# Only test funds. Keep bot tokens server-side. Local preview uses Sites local identity.
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=

# H5 customer verification (server-only). Set a random secret of at least 32 characters.
# demo accepts only fictional +12025550100..+12025550199 and never contacts Telegram.
PAYEASE_AUTH_MODE=demo
PAYEASE_AUTH_SECRET=
# Obtain from Telegram Gateway, NOT BotFather. Required only when mode=telegram.
TELEGRAM_GATEWAY_TOKEN=
