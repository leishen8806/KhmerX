{
    auto_https off
    admin off
}

:80 {
    root * /srv
    encode gzip

    # Keep browser requests same-origin. The API upstream is supplied by the
    # deployment environment; the client image never contains database keys.
    @api path /api/*
    handle @api {
        reverse_proxy {$PAYEASE_API_UPSTREAM} {
            # Identity headers belong to the trusted gateway only. Never pass
            # browser-supplied values to the API upstream.
            header_up -oai-authenticated-user-id
            header_up -oai-authenticated-user-email
            header_up -oai-authenticated-user-full-name
            header_up -oai-authenticated-user-full-name-encoding
            header_up -x-payease-identity-proof
            header_up -x-payease-identity-proof-ts
        }
    }

    # Vinext currently still renders page routes on the server. Serve the
    # separated browser assets locally and send page misses back to the API
    # service until the client-rendering spike is complete.
    @static file
    handle @static {
        file_server
    }
    handle {
        reverse_proxy {$PAYEASE_API_UPSTREAM} {
            header_up -oai-authenticated-user-id
            header_up -oai-authenticated-user-email
            header_up -oai-authenticated-user-full-name
            header_up -oai-authenticated-user-full-name-encoding
            header_up -x-payease-identity-proof
            header_up -x-payease-identity-proof-ts
        }
    }
}
